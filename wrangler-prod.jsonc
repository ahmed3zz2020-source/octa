/* ══════════════════════════════════════════════════════════════
   ⚙️ إعداد Cloudflare Worker — OCTA
   ──────────────────────────────────────────────────────────────
   ⭐⭐⭐ القاعدة الذهبية (١٤ نوفمبر ٢٠٢٦):
   **المعاينة والإنتاج لازم يكونوا متطابقين ١٠٠٪ في كل حاجة
   غير الاسم** ⇒ كأن المعاينة هي الدومين بالضبط.
   ⇒ لو في فرق ⇒ الدومين هيبسككت وقت التحويل.

   📌 الفرق الوحيد المسموح: `name` (اسم العامل على Cloudflare)
      + `account_id` لو الحساب اتغيّر.

   📌 ليه الملفين منفصلين أصلاً؟
      ⛔ لأن `wrangler deploy` من غير `--config` بياخد wrangler.jsonc
      ⇒ لو الملف ده كان الإنتاج ⇒ أي أمر نشر عادي بينشر على الإنتاج
      ⇒ ده بالظبط اللي حصل في ٩ نوفمبر (٤ نشرات على الإنتاج في ٥٢ ثانية).
   ✅ الحل: الافتراضي = المعاينة. والإنتاج = `wrangler-prod.jsonc`
      وبيحتاج عبارة صريحة («ارفع على الدومين»).
   ══════════════════════════════════════════════════════════════ */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  /* ⭐ اسم العامل — الإنتاج (octashares.com).
     📌 ⛔ الملف ده بيتنشر بـ tools/deploy.sh prod بس
     📌    (محتاج العبارة الصريحة «ارفع على الدومين»). */
  "name": "octa",
  "account_id": "74e046678adabf0706024b97b205882b",
  "compatibility_date": "2026-10-10",
  "main": "worker.js",
  "assets": {
    "directory": "./dist",
    /* ⛔⛔⛔ ٢٥ أكتوبر ٢٠٢٦ — ⭐ لازم run_worker_first
       📌 من غيرها Cloudflare بيقدّم الملف **من الكاش مباشرة**
       📌   ⇒ الـworker (الجسور + البوابة) مش بيشتغل.
       ✅ none ⇒ الـworker بس هو اللي بيتحكم في كل حاجة. */
    "run_worker_first": true,
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": false
  },
  /* ⭐ ٥ نوفمبر ٢٠٢٦ — إيقاظ السيرفر كل ٥ دقايق (scheduled trigger).
     📌 السبب: Railway بينام بعد السكون ⇒ أول طلب بيعمل cold start
     📌   (≈١٢ ثانية) ⇒ البوابة كانت بتقطع وبتطلع «السيرفر بطيء».
     📌 الحل: ping على /api/health كل ٥ دقايق ⇒ السيرفر ما بينامش.
     📌 ⭐ التكلفة = ٠ كريدت (مش LLM) — كود على Cloudflare.
     📌 ⭐ وبيفوق الـisolate بتاع الـWorker كمان (بيمنع cold start ليه هو). */
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  /* ⭐ ٩ نوفمبر ٢٠٢٦ — كاش هالان (بورصة مصر): الأحداث + عمق السوق.
     📌 قراءة بس من الموقع — الأسرار (توكن MCP) في عامل halan-feed بس. */
  "kv_namespaces": [
    { "binding": "HALAN_KV", "id": "8c9beca8ef09451b9767819d3060fb55" }
  ],
  "vars": {
    /* 🚪 البوابة (شاشة الدخول) — ON في المعاينة والإنتاج. */
    "OCTA_GATE": "on",
    /* ⭐ جسر TradingView — ON في الاتنين (الباك حيّ دلوقتي).
       📌 كان off في الإنتاج و on في المعاينة ⇒ فرق ⇒ عند التحويل
       📌   الرسوم البيانية كانت هتوقع في الإنتاج. */
    "OCTA_TV_PROXY": "on",
    /* ⭐ جسر مقارنة المصداقية (/api/bench) — read-only. */
    "OCTA_BENCH": "on",
    /* 📸 لقطة محرّك الفرص (OPP-001) — الـAPI لسه ما عندوش المسار
       📌   ⇒ اللقطة هي المصدر الوحيد ⇒ لازم ON في الاتنين. */
    "OCTA_OPP_SNAPSHOT": "on",
    /* 📸 لقطة المحفظة الذكية (OPP-002) — نفس المنطق. */
    "OCTA_ALPHA_SNAPSHOT": "on",
    /* ⛔ وضع الاختبار البطيء (?slowtest=1 ⇒ /api/auth/me بيتأخر ١٢ ثانية).
       📌 تشخيصي بس — مقفول في المعاينة والإنتاج مع بعض
       📌   (لو مفتوح ⇒ المعاينة ≠ الإنتاج). */
    "OCTA_SLOWTEST": "off"
  }
}
