{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "octa-mgmt",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    // 🛡️ الجولة ٢٥ (R25) — ⛔ html_handling التلقائي بيعيد توجيه
    //    `/login.html` ⇒ `/login.html/` ⭐ ⇒ ⛔ صفحة الدخول بتعمل حلقة ⭐.
    //    ⭐ `none` = بيرد على المسار كما هو ⭐ (زي إعدادات الموقع الرئيسي ⭐).
    "html_handling": "none",
    "not_found_handling": "none"
  },
  // 🛡️🛡️ الجولة ٢٥ (R25 · R24-I10) — تصريح بيئة الإنتاج ⭐
  // 📌 `APP_ENV=production` ⭐ ⇒ ⛔ **fail-closed** ⭐:
  //    ⛔ في الإنتاج: مافيش مصدر إبطال مشترك (لا DO ⭐ ولا KV ⭐)
  //    ⇒ ⛔ مسار الخروج يرجّع ٥٠٣ ⭐ بدل «نجاح» ⭐
  //    (الذاكرة المحلية مش حماية كافية عبر نسخ الـWorker ⭐).
  // ⭐ الاختبار الحارس: assets/tests/r25-logout-hardening.test.js (R25-I10-03) ⭐
  //    ⇒ لو حد شال التصريح ⇒ الاختبار يفشل ⭐.
  "vars": {
    "APP_ENV": "production"
  },
  // 🛡️🛡️ الجولة ٢٦ (R26) — ⭐ فصل مساحة الإبطال عن كاش السوق ⭐
  // 📌 قبل ⭐: `REVOKE_KV` كان **نفس** namespace بتاع `HALAN_KV` ⭐
  //    (كاش السوق العام بتاع الموقع ⭐).
  // ⛔ الأثر ⭐: ⭐ عامل الموقع (octa / octa-preview) ⭐ وعامل halan-feed ⭐
  //    عندهم ⭐ صلاحية كتابة ⭐ على نفس المساحة ⭐ ⇒ ⭐ يقدروا يمسحوا
  //    علامات إبطال جلسات الأدمن (`rev:*` ⭐) ⇒ ⛔ جلسة مبتطللة ترجع تُقبل ⭐.
  // ✅ الحل ⭐: ⭐ مساحة **مستقلة** ⭐ (`octa-session-revocation` ⭐)
  //    ⭐ ⇒ مافيش عامل تاني يقدر يمسح علامات الإبطال ⭐.
  // 📌 ملاحظة ⭐: `REVOKE_KV` **شاهد** ⭐ بس ⭐ — المرجع هو الـDO ⭐
  //    (قراءة بعد كتابة ⭐) ⇒ ⭐ تغيير المساحة ⛔ ما بيفقدش أي حالة إبطال ⭐.
  // ⭐ الاختبار الحارس: assets/tests/r26-kv-isolation.test.js ⭐
  //    ⇒ لو حد رجّع المساحة القديمة ⭐ ⇒ الاختبار يفشل ⭐.
  "kv_namespaces": [
    { "binding": "REVOKE_KV", "id": "bbbbeb98fd604c07980da23e99848209" }
  ],
  // ⭐⭐ الجولة ٢٢ (R22) — Durable Object للإبطال القوي (اتساق قوي ⭐)
  // 📌 ليه: ⛔ الـKV اتساقه متأخر (حتى ~٦٠ ثانية ⭐) ⇒ نافذة تقبل جلسة اتبطلت ⭐
  //   ⇒ الـDO قراءة بعد كتابة ⇒ ⛔ مافيش نافذة ⭐
  // ⛔ مافيش **namespace id** ⭐ — الـDO مش محتاج ID (خلاف الـKV ⭐)
  //   ⭐ والـmigration بتعمل الصنف **تلقائياً** أول نشر ⭐
  // ⚠️ `new_sqlite_classes` مش `new_classes` ⭐ — الـkey-value backend
  //   مش متاح غير على خطة Paid ⭐ والـSQLite هو المدعوم على الخطة المجانية ⭐
  //
  // 💰 التكلفة (الخطة المجانية ⭐ ⇒ **$0** ⭐):
  //   · 100,000 طلب/يوم ⭐ · 13,000 GB-s/يوم ⭐
  //   · SQL: 50 مليون صف قراءة/يوم ⭐ · 100,000 صف كتابة/يوم ⭐ · 5 GB تخزين ⭐
  //   ⇒ لوحة الأدمن ليها مستخدم واحد ⭐ ⇒ الطلبات أقل من عشرات في اليوم ⭐
  //   ⇒ داخل الحد المجاني بوضوح ⭐ ⇒ **مافيش فاتورة** ⭐
  // ⚠️ التفعيل: ⛔ المالك هو اللي ينشر ⭐ (أول نشر ⇒ الـDO بيتعمل ⭐)
  //   ⛔ مافيش نشر من غير موافقة صريحة ⭐ (قانون المشروع ⭐)
  "durable_objects": {
    "bindings": [
      { "name": "REVOKE_DO", "class_name": "RevokeDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RevokeDO"] }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "routes": [],
  "workers_dev": true
}
