{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "74e046678adabf0706024b97b205882b",
  "name": "octa-preview",
  "compatibility_date": "2026-10-10",
  "main": "worker.js",
  "assets": {
    "directory": "./dist",
    /* ⛔⛔⛔ ٢٥ أكتوبر ٢٠٢٦ — ⭐ run_worker_first + binding
       ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌
       📌 من غير run_worker_first: Cloudflare بيقدّم الأصول من الكاش
       ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌
       ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌
       ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⇒ والـworker (الجسور + البوابة) مش بيشتغل.
       ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌
       ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⇒ وكمان لازم الـbinding (ASSETS) عشان
       ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌
       ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ ⛌ env.ASSETS.fetch يشتغل. */
    "run_worker_first": true,
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "observability": { "enabled": false },
  /* ⭐ ٥ نوفمبر ٢٠٢٦ — إيقاظ السيرفر كل ٥ دقايق (scheduled trigger).
     📌 السبب: Railway بينام بعد السكون ⇒ أول طلب بيعمل cold start
     📌   (≈١٢ ثانية) ⇒ البوابة كانت بتقطع وبتطلع «السيرفر بطيء».
     📌 الحل: ping على /api/health كل ٥ دقايق ⇒ السيرفر ما بينامش.
     📌 ⭐ التكلفة = ٠ كريدت (مش LLM) — كود على Cloudflare.
     📌 ⭐ ملاحظة: الـWorker بتاع المعاينة بيعمل ping لـRailway نفسو
     📌   ⇒ المعاينة لوحدها بتفوق السيرفر — والدومين بيستفيد. */
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    /* ⭐ OPP-001 — لقطة محرّك الفرص (للمعاينة بس).
       📌 الباك لسه ما اتنشرش ⇒ /api/opp/* بيرجّع 405.
       📌 الأولوية دايماً للباك الحيّ — اللقطة fallback بس.
       ⛔ في الإنتاج الـOCTA_OPP_SNAPSHOT مش مفعّل + الملف
          مش بيننسخ في بناء الإنتاج ⇒ صفر تسرّب. */
    "OCTA_OPP_SNAPSHOT": "on",
    /* ⛔ ٢٨ أكتوبر ٢٠٢٦ — البوابة بقت ON في المعاينة.
     📌 السبب: مسارات «نماذجي» و«الاستوديو» محمية (لازم توكن)
     ⇒ من غير دخول مش هيشوفوا حاجة.
     📌 الدخول = نفس حساب الإنتاج (البوابة بتروح لنفس الـAPI).
     ⛌ لو عايز المعاينة مفتوحة ⇒ رجّعها "off" (بس الصفحات الجديدة
     ⛌   هتفضل «لازم تسجّل دخول»). */
    "OCTA_GATE": "on",
    "OCTA_TV_PROXY": "on",
    "OCTA_BENCH": "on",
    /* ⭐ ٥ نوفمبر ٢٠٢٦ — وضع الاختبار البطيء (تشخيصي).
       📌 ?slowtest=1 ⇒ /api/auth/me يتأخر ١٢ ثانية (محاكاة cold start)
       📌 عشان المالك يشوف الفرق بنفسه. ⛔ المعاينة بس — الإنتاج مفعّلوش. */
    "OCTA_SLOWTEST": "1"
  }
}
